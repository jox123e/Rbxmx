{
  "name": "DevBuild",
  "tree": {
    "$className": "DataModel",
    "$path": "src",
    "Workspace": {
      "$className": "Workspace"
    },
    "HttpService": {
      "$className": "HttpService",
      "$properties": {
        "HttpEnabled": true
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$properties": {
        "LoadStringEnabled": true
      }
    }
  }
}
