
{
  "name": "SpawnProyecto",
  "tree": {
    "$className": "DataModel",
    "HttpService": {
      "$className": "HttpService",
      "$properties": {
        "HttpEnabled": true
      }
    },
    "InsertService": {
      "$className": "InsertService",
      "$properties": {
        "AllowInsertFreeModels": true
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$properties": {
        "LoadStringEnabled": true
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": true,
        "StreamingEnabledStorage": true,
        "AllowThirdPartySales": true,
        "AuthorityMode": "Automatic",
        "NeedsPivotMigration": false
      },
      "$path": "src/assets/WS"
    }
  }
}
